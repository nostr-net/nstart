{
	"name": "nstart",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev --port 4647",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"start": "node server.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.0",
		"@types/node": "^24.19.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fiatjaf/promenade-trusted-dealer": "npm:@jsr/fiatjaf__promenade-trusted-dealer@^0.2.0",
		"@nostr/gadgets": "npm:@jsr/nostr__gadgets@^0.0.4",
		"@nostr/tools": "npm:@jsr/nostr__tools@2.10.3",
		"hash-wasm": "^4.12.0",
		"nodemailer": "^10.1.2",
		"nostr-tools": "2.9.4",
		"qr-code-styling": "^1.9.2"
	},
	"overrides": {
		"@jsr/nostr__tools": "2.10.3"
	}
}
